// JPortal Database Definition Language Grammar
WHITESPACE = _{ " " | "\t" | "\n" | "\r" }
COMMENT = _{ ("/*" ~ (!"*/" ~ ANY)* ~ "*/") | ("//" ~ (!NEWLINE ~ ANY)*) | ("**" ~ (!NEWLINE ~ ANY)*) }

// Keywords (case insensitive)
DATABASE = { ^"database" }
FLAGS = { ^"flags" }
PACKAGE = { ^"package" }
OUTPUT = { ^"output" }
IMPORT = { ^"import" }
SERVER = { ^"server" }
SCHEMA = { ^"schema" }
USERID = { ^"userid" }
PASSWORD = { ^"password" }
TABLE = { ^"table" }
VIEW = { ^"view" }
NOT = { ^"not" }
NULL = { ^"null" }
DEFAULT = { ^"default" }
DEFAULTV = { ^"defaultv" }
CHECK = { ^"check" }
PROC = { ^"proc" }
SPROC = { ^"sproc" }
PARM = { ^"parm" }
KEY = { ^"key" }
LINK = { ^"link" }
GRANT = { ^"grant" }
ALIAS = { ^"alias" }
OPTIONS = { ^"options" }
CALC = { ^"calc" }

// Additional keywords for enhanced functionality
CONST = { ^"const" }
TO = { ^"to" }
CODE = { ^"code" }
ENDCODE = { ^"endcode" }
SQLCODE = { ^"sqlcode" }
ENDSQLCODE = { ^"endsqlcode" }
CODELINE = { ^"codeline" }
UNIQUE = { ^"unique" }
PRIMARY = { ^"primary" }
CASCADE = { ^"cascade" }

// Data and IDL block keywords
SQLDATA = { ^"sqldata" }
ENDDATA = { ^"enddata" }
IDLCODE = { ^"idlcode" }
ENDIDLCODE = { ^"endidlcode" }

// Permission keywords
ALL = { ^"all" }
DELETE = { ^"delete" }
SELECT = { ^"select" }
EXECUTE = { ^"execute" }

// Parameter keywords
PARMSHOWS = { ^"parmshows" }
PARMVIEWONLY = { ^"parmviewonly" }
PARMSUPPLIED = { ^"parmsupplied" }
PARMCACHE = { ^"parmcache" }
PARMREADER = { ^"parmreader" }
PARMINSERT = { ^"parminsert" }
PARMUPDATE = { ^"parmupdate" }
PARMDELETE = { ^"parmdelete" }
SELECTALL = { ^"selectall" }
INSERT = { ^"insert" }
UPDATE = { ^"update" }
DELETEONE = { ^"deleteone" }

// Standard procedure keywords
RETURNING = { ^"returning" }
UPDATEFOR = { ^"updatefor" }
UPDATEBY = { ^"updateby" }
SET = { ^"set" }
AS = { ^"as" }
BULKINSERT = { ^"bulkinsert" }
MAXTMSTAMP = { ^"maxtmstamp" }
BULKUPDATE = { ^"bulkupdate" }
DELETEALL = { ^"deleteall" }
DELETEBY = { ^"deleteby" }
SELECTONE = { ^"selectone" }
SELECTONEBY = { ^"selectoneby" }
SELECTBY = { ^"selectby" }
FOR = { ^"for" }
READONLY = { ^"readonly" }
IN = { ^"in" }
ORDER = { ^"order" }
DESC = { ^"desc" }
COUNT = { ^"count" }
EXISTS = { ^"exists" }
MERGE = { ^"merge" }
STANDARD = { ^"standard" }

// Additional tokens for jNewProc
INPUT = { ^"input" }
INOUT = { ^"inout" }
SQL = { ^"sql" }
MULTIPLE = { ^"multiple" }
SINGLE = { ^"single" }

// Field types (simplified)
BLOB = { ^"blob" }
BOOLEAN = { ^"boolean" | ^"bit" }
BYTE = { ^"byte" }
CHAR = { ^"char" }
ANSICHAR = { ^"ansichar" | ^"ansi" }
WCHAR = { ^"wchar" }
WANSICHAR = { ^"wansichar" | ^"wansi" }
UTF8 = { ^"utf8" }
SHORT = { ^"short" }
INT = { ^"int" | ^"integer" }
LONG = { ^"long" }
UID = { ^"uid" }
DATE = { ^"date" }
DATETIME = { ^"datetime" }
TIME = { ^"time" }
TIMESTAMP = { ^"timestamp" }
AUTOTIMESTAMP = { ^"autotimestamp" }
TLOB = { ^"tlob" | ^"clob" }
XML = { ^"xml" }
BIGXML = { ^"bigxml" }
JSON = { ^"json" }
BIGJSON = { ^"bigjson" }
USERSTAMP = { ^"userstamp" }
SEQUENCE = { ^"sequence" }
BIGSEQUENCE = { ^"bigsequence" }
IDENTITY = { ^"identity" }
BIGIDENTITY = { ^"bigidentity" }
DOUBLE = { ^"double" }
FLOAT = { ^"float" }
MONEY = { ^"money" }

// Separators and operators
EQUALS = { "=" }
COMMA = { "," }
LEFTPAREN = { "(" }
RIGHTPAREN = { ")" }
LEFTBRACK = { "[" }
RIGHTBRACK = { "]" }
LEFTBRACE = { "{" }
RIGHTBRACE = { "}" }

// Literals
number = @{ ("-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)?) | "0" }
string_literal = @{ 
    ("\"" ~ (!"\"" ~ (("\\" ~ ANY) | ANY))* ~ "\"") |
    ("'" ~ (!"'" ~ (("\\" ~ ANY) | ANY))* ~ "'")
}

// Identifiers - enhanced to match JavaCC jIdent() behavior
identifier = @{ (ASCII_ALPHA | "_" | "#" | "$") ~ (ASCII_ALPHANUMERIC | "_" | "#" | "$")* }
literal_identifier = @{ ("l" | "L") ~ "'" ~ (!"'" ~ ANY)* ~ "'" }

// Package identifier (can contain dots) - matches jPackageIdent()
package_ident = { identifier ~ ("." ~ identifier)* }

// Identifier or string - matches jIdentOrString()
ident_or_string = { literal_identifier | string_literal | identifier }

// Raw content for various block types
raw_line = @{ (!NEWLINE ~ ANY)+ ~ NEWLINE? }
data_line = @{ (!NEWLINE ~ !("PROC" ~ WHITESPACE) ~ !("SPROC" ~ WHITESPACE) ~ ANY)+ ~ NEWLINE? }
idl_line = @{ (!NEWLINE ~ !("PROC" ~ WHITESPACE) ~ !("SPROC" ~ WHITESPACE) ~ ANY)+ ~ NEWLINE? }

// Database structure
database = {
    SOI ~
    DATABASE ~ database_name ~
    flags_section? ~
    package_section? ~
    (output_section | import_section)* ~
    connect_section ~
    tables_section ~
    EOI
}

database_name = { literal_identifier | identifier }

flags_section = {
    FLAGS ~ string_literal+
}

package_section = {
    PACKAGE ~ package_ident
}

output_section = {
    OUTPUT ~ ident_or_string
}

import_section = {
    IMPORT ~ ident_or_string
}

connect_section = {
    server_clause ~
    schema_clause? ~
    (userid_clause ~ password_clause)?
}

server_clause = {
    SERVER ~ ident_or_string
}

schema_clause = {
    SCHEMA ~ ident_or_string
}

userid_clause = {
    USERID ~ identifier
}

password_clause = {
    PASSWORD ~ identifier
}

// Tables section - matches jTables() structure
tables_section = {
    table_definition+
}

table_definition = {
    (table_section | table_import_section) ~
    (const_section | enhanced_grant_section | original_grant_section | enhanced_key_section | original_key_section | enhanced_link_section | original_link_section | enhanced_view_section | proc_section | parm_section)* 
}

// Enhanced table structure - matches jTable()
table_section = {
    TABLE ~ identifier ~ 
    alias_clause? ~
    check_clause? ~
    comment_clause* ~
    options_clause? ~
    (field_def | package_field_def)*
}

// Enhanced table import - matches jTableImport()
table_import_section = {
    IMPORT ~ ident_or_string ~ 
    field_import_list? ~
    alias_clause?
}

field_import_list = {
    LEFTBRACK ~ identifier+ ~ RIGHTBRACK
}

alias_clause = {
    ALIAS ~ ident_or_string
}

// Enhanced alias with parentheses - matches jAlias()
paren_alias_clause = {
    LEFTPAREN ~ identifier ~ RIGHTPAREN
}

check_clause = {
    CHECK ~ string_literal
}

comment_clause = {
    string_literal  // Comments are just string literals
}

options_clause = {
    OPTIONS ~ string_literal+
}

// Table extras (keys, links, grants, views, constants, etc.)
table_extras = {
    const_section | enhanced_grant_section | enhanced_key_section | enhanced_link_section | enhanced_view_section
}

// Constants section - matches jConst()
const_section = {
    CONST ~ identifier ~ const_value+
}

const_value = {
    identifier ~ EQUALS ~ string_literal ~ COMMA?
}

// Enhanced grant section - matches jGrant()
enhanced_grant_section = {
    GRANT ~ permission+ ~ TO ~ non_keyword_identifier+
}

// Original grant section for backward compatibility
original_grant_section = {
    GRANT ~ identifier ~ field_list?
}

permission = {
    ALL | DELETE | INSERT | SELECT | UPDATE | EXECUTE
}

user = {
    non_keyword_identifier
}

// Non-keyword identifier for users to avoid conflicts
non_keyword_identifier = @{ 
    !(keyword ~ !(ASCII_ALPHANUMERIC | "_")) ~
    identifier 
}

// All keywords that should not be matched as identifiers
keyword = {
    ALL | DELETE | INSERT | SELECT | UPDATE | EXECUTE | GRANT | TO | KEY | LINK | VIEW | CONST | 
    PROC | SPROC | PARM | TABLE | DATABASE | SERVER | SCHEMA | USERID | PASSWORD | FLAGS | 
    PACKAGE | OUTPUT | IMPORT | ALIAS | OPTIONS | CHECK | NOT | NULL | DEFAULT | DEFAULTV | 
    CALC | CASCADE | UNIQUE | PRIMARY | CODE | ENDCODE | RETURNING | UPDATEFOR | UPDATEBY | 
    SET | AS | BULKINSERT | MAXTMSTAMP | BULKUPDATE | DELETEALL | DELETEBY | SELECTONE | 
    SELECTONEBY | SELECTBY | FOR | READONLY | IN | ORDER | DESC | COUNT | EXISTS | MERGE | STANDARD |
    SQLDATA | ENDDATA | IDLCODE | ENDIDLCODE | INPUT | INOUT | SQL | MULTIPLE | SINGLE
}

// Enhanced key section - matches jKey()
enhanced_key_section = {
    KEY ~ identifier ~ 
    (OPTIONS ~ string_literal+)* ~
    key_modifier* ~
    non_keyword_identifier+
}

// Original key section for backward compatibility
original_key_section = {
    KEY ~ identifier ~ field_list?
}

key_modifier = {
    UNIQUE | PRIMARY
}

key_column = {
    non_keyword_identifier
}

// Enhanced link section - matches jLink()
enhanced_link_section = {
    LINK ~ package_ident ~
    (LEFTPAREN ~ non_keyword_identifier+ ~ RIGHTPAREN)? ~
    (DELETE ~ CASCADE?)? ~
    (UPDATE ~ CASCADE?)? ~
    (OPTIONS ~ string_literal+)* ~
    non_keyword_identifier+
}

// Original link section for backward compatibility
original_link_section = {
    LINK ~ identifier ~ field_list?
}

link_column = {
    non_keyword_identifier
}

// Enhanced view section - matches jView()
enhanced_view_section = {
    VIEW ~ identifier ~
    (TO ~ non_keyword_identifier+)? ~
    (OUTPUT ~ view_alias+)? ~
    (view_code | old_view_code)?
}

view_alias = {
    identifier
}

view_code = {
    codeline+
}

old_view_code = {
    CODE ~ raw_content ~ ENDCODE
}

// Raw content for CODE/ENDCODE blocks - matches JavaCC jOldViewCode() behavior
raw_content = @{ (!NEWLINE ~ ANY)+ ~ NEWLINE? }

codeline = {
    string_literal
}

// Procedure section - enhanced to support data and IDL blocks
proc_section = {
    (PROC | SPROC) ~ (
        // Data blocks - matches jNewData()
        (SQLDATA ~ data_line+) |
        // IDL code blocks - matches jIdlCode()
        (IDLCODE ~ idl_line+) |
        // Regular procedure
        (identifier ~ (
            // Built-in procedure patterns with optional OPTIONS and OUTPUT
            (
                (UPDATEBY ~ proc_column+ ~ (SET ~ proc_column+)? ~ (AS ~ identifier)?) |
                (INSERT ~ (RETURNING)?) |
                (UPDATE) |
                (UPDATEFOR ~ proc_column+) |
                (BULKINSERT ~ row_count?) |
                (MAXTMSTAMP) |
                (BULKUPDATE ~ row_count?) |
                (DELETEONE ~ (LEFTPAREN ~ STANDARD ~ RIGHTPAREN)?) |
                (DELETEALL) |
                (DELETEBY ~ proc_column+) |
                (SELECTONEBY ~ proc_column+ ~ ((IN)? ~ ORDER)? ~ ((FOR)? ~ (UPDATE | READONLY))? ~ (AS ~ identifier)?) |
                (SELECTONE ~ ((FOR)? ~ (UPDATE | READONLY))?) |
                (SELECTBY ~ proc_column+ ~ ((IN)? ~ ORDER ~ order_column* ~ (DESC)?)? ~ ((FOR)? ~ (UPDATE | READONLY))? ~ (AS ~ identifier)?) |
                (SELECTALL ~ ((IN)? ~ ORDER ~ order_column* ~ (DESC)?)? ~ ((FOR)? ~ (UPDATE | READONLY))?) |
                (COUNT) |
                (EXISTS) |
                (MERGE)
            ) ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
            // Custom SELECT procedure (jNewProc equivalent)
            custom_select_proc |
            // Regular procedure body
            user_proc
        )?)
    )
}

// New data block parsing - matches jNewData()
new_data_block = {
    SQLDATA ~ data_line+
}

// IDL code block parsing - matches jIdlCode()
idl_code_block = {
    IDLCODE ~ idl_line+
}

// Data content for old data blocks - simplified
data_content = {
    string_literal
}

proc_options = {
    OPTIONS ~ string_literal+
}

proc_output = {
    OUTPUT ~ field_def*
}

proc_body = {
    LEFTBRACE ~ proc_content* ~ RIGHTBRACE
}

proc_content = {
    field_def | package_field_def | identifier | string_literal | number
}

// Standard procedure section - matches jStdProc()
std_proc_section = {
    insert_proc |
    update_proc |
    updatefor_proc |
    updateby_proc |
    bulkinsert_proc |
    maxtmstamp_proc |
    bulkupdate_proc |
    deleteone_proc |
    deleteall_proc |
    deleteby_proc |
    selectone_proc |
    selectoneby_proc |
    selectby_proc |
    selectall_proc |
    count_proc |
    exists_proc |
    merge_proc
}

insert_proc = { INSERT ~ (RETURNING)? }
update_proc = { UPDATE }
updatefor_proc = { UPDATEFOR ~ proc_column+ }
updateby_proc = { UPDATEBY ~ proc_column+ ~ (SET ~ proc_column+)? ~ (AS ~ identifier)? }
bulkinsert_proc = { BULKINSERT ~ row_count? }
maxtmstamp_proc = { MAXTMSTAMP }
bulkupdate_proc = { BULKUPDATE ~ row_count? }
deleteone_proc = { DELETEONE ~ (LEFTPAREN ~ STANDARD ~ RIGHTPAREN)? }
deleteall_proc = { DELETEALL }
deleteby_proc = { DELETEBY ~ proc_column+ }
selectone_proc = { SELECTONE ~ ((FOR)? ~ (UPDATE | READONLY))? }
selectoneby_proc = { SELECTONEBY ~ proc_column+ ~ ((IN)? ~ ORDER)? ~ ((FOR)? ~ (UPDATE | READONLY))? ~ (AS ~ identifier)? }
selectby_proc = { SELECTBY ~ proc_column+ ~ ((IN)? ~ ORDER ~ order_column* ~ (DESC)?)? ~ ((FOR)? ~ (UPDATE | READONLY))? ~ (AS ~ identifier)? }
selectall_proc = { SELECTALL ~ ((IN)? ~ ORDER ~ order_column* ~ (DESC)?)? ~ ((FOR)? ~ (UPDATE | READONLY))? }
count_proc = { COUNT }
exists_proc = { EXISTS }
merge_proc = { MERGE }

// Procedure column reference
proc_column = {
    non_keyword_identifier
}

// Procedure update by column reference
proc_update_by_column = {
    non_keyword_identifier
}

// Procedure returning column reference
proc_returning_column = {
    non_keyword_identifier
}

// Order column reference
order_column = {
    non_keyword_identifier
}

// Row count specification for bulk operations
row_count = {
    LEFTPAREN ~ number ~ RIGHTPAREN
}


// Enhanced parameter section - matches jParm()
parm_section = {
    PARM ~ parm_body?
}

parm_body = {
    LEFTBRACE ~ parm_content* ~ RIGHTBRACE
}

parm_content = {
    string_literal | PARMSHOWS | PARMVIEWONLY | PARMSUPPLIED | PARMCACHE | PARMREADER | PARMINSERT | PARMUPDATE | PARMDELETE | SELECTALL | INSERT | UPDATE | DELETEONE | identifier | number
}

// Parameter directives
parm_directive = {
    (string_literal) |  // title
    (PARMSHOWS ~ identifier+) |
    (PARMVIEWONLY) |
    (PARMSUPPLIED ~ identifier+) |
    (PARMCACHE ~ (identifier | SELECTALL) ~ identifier*) |
    (PARMREADER ~ (identifier | SELECTALL)) |
    (PARMINSERT ~ (identifier | INSERT)) |
    (PARMUPDATE ~ (identifier | UPDATE)) |
    (PARMDELETE ~ (identifier | DELETEONE))
}

// Enhanced field definitions - matches jPackageField()
package_field_def = {
    package_ident ~ field_type ~ alias_clause? ~ package_field_modifiers* ~ comment_clause*
}

// Enhanced field definition - matches jField()
field_def = {
    identifier ~ paren_alias_clause? ~ (field_type ~ field_modifiers* | lookup_type) ~ comment_clause*
}

// Enhanced field types with size specifications - matches jDatatype()
field_type = {
    TIMESTAMP |
    AUTOTIMESTAMP |
    BLOB ~ (enhanced_char_size)? |
    BOOLEAN |
    BYTE ~ (enhanced_enum_value | enhanced_char_list | enum_value | char_list)? |
    CHAR ~ enhanced_char_size? ~ (enhanced_char_list | char_list)? |
    ANSICHAR ~ (enhanced_enum_char | enhanced_char_list | char_list)? |
    WCHAR ~ enhanced_char_size? ~ (enhanced_char_list | char_list)? |
    WANSICHAR ~ (enhanced_enum_char | enhanced_char_list | char_list)? |
    UTF8 ~ enhanced_char_size? ~ (enhanced_char_list | char_list)? |
    SHORT ~ (enhanced_enum_value | enhanced_char_list | enum_value | char_list)? |
    INT ~ (enhanced_enum_value | enhanced_char_list | enum_value | char_list)? |
    LONG |
    UID |
    DATETIME |
    DATE |
    TIME |
    TLOB ~ (enhanced_char_size)? |
    XML ~ (enhanced_char_size)? |
    BIGXML ~ (enhanced_char_size)? |
    JSON ~ (enhanced_char_size)? |
    BIGJSON ~ (enhanced_char_size)? |
    USERSTAMP |
    SEQUENCE |
    BIGSEQUENCE |
    IDENTITY |
    BIGIDENTITY |
    (DOUBLE | FLOAT) ~ (enhanced_float_size | float_size)? |
    MONEY ~ (enhanced_float_size | float_size)?
}

// Enhanced size specifications - matches jCharsize()
enhanced_char_size = {
    (LEFTBRACK ~ number ~ RIGHTBRACK) |
    (LEFTPAREN ~ number ~ RIGHTPAREN) |
    number
}

// Enhanced float size - matches jFloatsize()
enhanced_float_size = {
    (LEFTBRACK ~ number ~ COMMA ~ number ~ RIGHTBRACK) |
    (LEFTPAREN ~ number ~ COMMA ~ number ~ RIGHTPAREN)
}

// Enhanced enum specifications - matches jEnumValue()
enhanced_enum_value = {
    LEFTPAREN ~ 
    (LINK ~ identifier)? ~
    (enum_item ~ COMMA?)+ ~
    RIGHTPAREN
}

enum_item = {
    identifier ~ EQUALS ~ number
}

// Enhanced char list - matches jCharList()
enhanced_char_list = {
    LEFTBRACE ~ 
    (identifier ~ COMMA?)+ ~
    RIGHTBRACE
}

// Enhanced enum char - matches jEnumChar()
enhanced_enum_char = {
    (LEFTBRACK ~ number ~ RIGHTBRACK) |
    (LEFTPAREN ~ 
        (number | 
         ((LINK ~ identifier)? ~ (enum_char_item ~ COMMA?)+)
        ) ~ 
     RIGHTPAREN) |
    number
}

enum_char_item = {
    identifier ~ EQUALS ~ number  // Using number for ASCII char values
}

// Original char_list for backward compatibility
char_list = {
    LEFTPAREN ~ string_literal ~ (COMMA ~ string_literal)* ~ RIGHTPAREN
}

// Original enum_value for backward compatibility
enum_value = {
    LEFTPAREN ~ enum_item ~ (COMMA ~ enum_item)* ~ RIGHTPAREN
}

// Lookup type - matches jLookup()
lookup_type = {
    EQUALS ~ (LEFTPAREN ~ identifier ~ RIGHTPAREN)?
}

field_modifiers = {
    (DEFAULTV ~ string_literal) |
    ((NOT)? ~ NULL) |
    CALC |
    (CHECK ~ string_literal) |
    lookup_type
}

// Enhanced package field modifiers - matches jPackageField() modifiers
package_field_modifiers = {
    (DEFAULTV ~ string_literal) |
    ((NOT)? ~ NULL) |
    CALC |
    (CHECK ~ string_literal)
}

// Original float size for backward compatibility
float_size = {
    LEFTPAREN ~ number ~ (COMMA ~ number)? ~ RIGHTPAREN
}

// Field list for backward compatibility
field_list = {
    LEFTPAREN ~ identifier ~ (COMMA ~ identifier)* ~ RIGHTPAREN
}

// Standard procedure patterns
standard_proc = {
    insert_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    update_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    updatefor_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    updateby_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    bulkinsert_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    maxtmstamp_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    bulkupdate_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    deleteone_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    deleteall_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    deleteby_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    selectone_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    selectoneby_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    selectby_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    selectall_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    count_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    exists_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)? |
    merge_proc ~ (OPTIONS ~ string_literal+)? ~ (OUTPUT ~ field_def*)?
}

// Custom procedure with SELECT statement
custom_select_proc = {
    SELECT ~
    (LEFTPAREN ~ STANDARD ~ RIGHTPAREN)? ~
    (INPUT ~ enhanced_input_type? ~ field_def*)? ~
    (OUTPUT ~ enhanced_output_type? ~ field_def*)? ~
    (old_code | new_code)
}

// Enhanced input type specifications - matches jInputType()
enhanced_input_type = {
    (LEFTPAREN ~ MULTIPLE ~ RIGHTPAREN) |
    (LEFTPAREN ~ number ~ RIGHTPAREN) |
    (LEFTPAREN ~ STANDARD ~ RIGHTPAREN)
}

// Enhanced output type specifications - matches jOutputType()
enhanced_output_type = {
    (LEFTPAREN ~ SINGLE ~ (STANDARD)? ~ RIGHTPAREN) |
    (LEFTPAREN ~ SINGLE ~ (UPDATE)? ~ RIGHTPAREN) |
    (LEFTPAREN ~ number ~ RIGHTPAREN) |
    (LEFTPAREN ~ STANDARD ~ (SINGLE)? ~ RIGHTPAREN)
}

// Input type specifications
input_type = {
    (LEFTPAREN ~ MULTIPLE ~ RIGHTPAREN) |
    (LEFTPAREN ~ number ~ RIGHTPAREN) |
    (LEFTPAREN ~ STANDARD ~ RIGHTPAREN)
}

// Output type specifications  
output_type = {
    (LEFTPAREN ~ SINGLE ~ (STANDARD)? ~ RIGHTPAREN) |
    (LEFTPAREN ~ SINGLE ~ (UPDATE)? ~ RIGHTPAREN) |
    (LEFTPAREN ~ number ~ RIGHTPAREN) |
    (LEFTPAREN ~ STANDARD ~ (SINGLE)? ~ RIGHTPAREN)
}

// Enhanced old style code block - matches jOldCode()
old_code = {
    (SQL)? ~
    CODE ~
    old_code_content ~
    ENDCODE
}

// Raw content for CODE blocks - matches everything until ENDCODE
old_code_content = @{
    (!ENDCODE ~ ANY)*
}

// New style code block - matches jNewCode() with SQLCODE/ENDSQLCODE
new_code = {
    SQLCODE ~
    sqlcode_content ~
    ENDSQLCODE
}

// Raw content for SQLCODE blocks - matches everything until ENDSQLCODE
sqlcode_content = @{
    (!ENDSQLCODE ~ ANY)*
}

// Optional size specification - matches jOptSize()
opt_size = {
    LEFTPAREN ~ number ~ RIGHTPAREN
}

// User-defined procedure - matches jUserProc()
user_proc = {
    (LEFTPAREN ~ STANDARD ~ RIGHTPAREN)? ~
    comment_clause* ~
    (OPTIONS ~ string_literal+)* ~
    (INPUT ~ enhanced_input_type? ~ field_def*)? ~
    (INOUT ~ enhanced_output_type? ~ field_def*)? ~
    (OUTPUT ~ enhanced_output_type? ~ field_def*)? ~
    (old_code | new_code)
} 